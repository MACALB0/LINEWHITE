{
  "name": "app",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "report:e2e": "playwright show-report reports/playwright-html",
    "allure:generate": "allure generate allure-results --clean -o reports/allure-report",
    "allure:open": "allure open reports/allure-report",
    "test:bdd:login": "cucumber-js --config cucumber-login.js",
    "test:e2e:allure": "playwright test && allure generate allure-results --clean -o reports/allure-report",
    "test:bdd:run": "cucumber-js",
    "test:bdd": "start-server-and-test start http://127.0.0.1:7055 test:bdd:run",
    "test:ai": "jest --config jest.ai.config.js --runInBand",
    "test:ai:bdd:run": "cucumber-js --config cucumber-ai.js",
    "test:ai:bdd": "start-server-and-test start http://127.0.0.1:7055 test:ai:bdd:run",
    "test:ai:e2e": "playwright test --config=playwright.ai.config.js",
    "test:cross-browser": "playwright test --config=playwright.cross-browser.config.js",
    "test:cross-browser:login": "playwright test tests/e2e/login.spec.js --config=playwright.cross-browser.config.js",
    "report:cross-browser": "playwright show-report reports/cross-browser-html"
  },
  "dependencies": {
    "admin-lte": "^4.0.0-rc6",
    "argon2": "^0.45.1",
    "connect-flash": "^0.1.1",
    "cookie-parser": "^1.4.7",
    "debug": "^4.4.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "http-errors": "^2.0.1",
    "morgan": "^1.10.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.22.0",
    "pug": "^3.0.3",
    "session-file-store": "^1.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cucumber/cucumber": "^13.2.1",
    "@playwright/test": "^1.62.1",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "backstopjs": "^6.3.25",
    "jest": "^30.4.2",
    "start-server-and-test": "^3.0.12",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/unit/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "app.js",
      "controllers/components/**/*.js",
      "middlewares/**/*.js",
      "config/passport.js",
      "!controllers/all_controllers.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  }
}
