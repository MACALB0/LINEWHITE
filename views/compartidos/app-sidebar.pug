// begin::Sidebar
aside(class="app-sidebar bg-primary-subtle shadow", data-bs-theme="dark")
	// begin::Sidebar Brand
	div(class="sidebar-brand")
		// begin::Brand Link
		a(href="./index.html", class="brand-link")
			// begin::Brand Image
			img(src="./images/Home_L_W_S.png", alt="AdminLTE Logo", class="brand-image opacity-75 shadow")
			// end::Brand Image
			// begin::Brand Text
			span(class="brand-text fw-light") Line White Services
			// end::Brand Text
		// end::Brand Link
	// end::Sidebar Brand
	// begin::Sidebar Wrapper
	div(class="sidebar-wrapper")
		nav(class="mt-2")
			// begin::Sidebar Menu
			ul#navigation(class="nav sidebar-menu flex-column", data-lte-toggle="treeview", role="navigation", aria-label="Main navigation", data-accordion="false")
				li(class=`nav-item ${['/facturas', '/index', '/inventario', '/ordenes_tecnicas', '/usuarios'].includes(currentPath) ? 'menu-open' : ''}`)
					a(href="#", class="nav-link active")
						i(class="nav-icon bi bi-speedometer")
						p
							| Dashboard
							i(class="nav-arrow bi bi-chevron-right")
					ul(class="nav nav-treeview")
						li(class="nav-item")
							a(href="/index", class=`nav-link ${currentPath === '/index' ? 'active' : ''}`)
								i(class="nav-icon bi bi-circle")
								p Inicio
						li(class="nav-item")
							a(href="/inventario", class=`nav-link ${currentPath === '/inventario' ? 'active' : ''}` )
								i(class="nav-icon bi bi-circle")
								p Inventario
						li(class="nav-item")
							a(href="/facturas", class=`nav-link ${currentPath === '/facturas' ? 'active' : ''}`)
								i(class="nav-icon bi bi-circle")
								p Facturas
						li(class="nav-item")
							a(href="/ordenes_tecnicas", class=`nav-link ${currentPath === '/ordenes_tecnicas' ? 'active' : ''}`)
								i(class="nav-icon bi bi-circle")
								p Ordenes tecnicas
						li(class="nav-item")
							a(href="/usuarios", class=`nav-link ${currentPath === '/usuarios' ? 'active' : ''}`)
								i(class="nav-icon bi bi-circle")
								p Usuarios
			// end::Sidebar Menu
	// end::Sidebar Wrapper
// end::Sidebar
