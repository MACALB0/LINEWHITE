extends ../index

block content_app_main
	// begin::App Main
	main(class="app-main")
		// begin::App Content Header
		div(class="app-content-header")
			// begin::Container
			div(class="container-fluid")
				// begin::Row
				div(class="row")
					div(class="col-sm-6")
						h3(class="mb-0") #{breadcrumb_name}
					div(class="col-sm-6")
						ol(class="breadcrumb float-sm-end")
							li(class="breadcrumb-item")
								a(href="#") Inicio
							li(class="breadcrumb-item active", aria-current="page") #{breadcrumb_name}
				// end::Row
			// end::Container
		// end::App Content Header
		// begin::App Content
		div(class="app-content")
			// begin::Container
			block content_secciones
			// end::Container
		// end::App Content
	// end::App Main