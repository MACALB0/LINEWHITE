doctype html
html
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title Login | Line White Services
    link(rel="stylesheet", href="/adminlte/css/adminlte.min.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")
    style.
      body {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: linear-gradient(-45deg, #4e73df, #1cc88a, #36b9cc, #f6c23e);
        background-size: 400% 400%;
        animation: gradientBG 15s ease infinite;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      }
      @keyframes gradientBG {
        0% {background-position:0% 50%;}
        50% {background-position:100% 50%;}
        100% {background-position:0% 50%;}
      }

      .login-card {
        border-radius: 20px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.5);
        overflow: hidden;
        width: 420px;
        background: #ffffffdd;
        backdrop-filter: blur(12px);
        transition: transform 0.3s;
      }

      .login-logo img {
        width: 100%;
        
        max-height: 175px;
        display: block;
        margin: 0 auto 1rem auto;

        border-radius: 0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
      }

      .shake {
        animation: shakeAnim 0.5s;
      }
      @keyframes shakeAnim {
        0%, 100% { transform: translateX(0); }
        20%, 60% { transform: translateX(-10px); }
        40%, 80% { transform: translateX(10px); }
      }

      .form-control:focus {
        border-color: #1cc88a;
        box-shadow: 0 0 8px #1cc88a;
      }
      .btn-primary {
        background-color: #4e73df;
        border-color: #4e73df;
        transition: 0.3s;
      }
      .btn-primary:hover {
        background-color: #1cc88a;
        border-color: #1cc88a;
      }

      .input-group-text {
        background-color: #f8f9fc;
        border-left: 0;
      }

      .login-footer a {
        color: #4e73df;
        text-decoration: none;
        transition: 0.2s;
      }
      .login-footer a:hover {
        text-decoration: underline;
      }

      .social-login a {
        font-size: 1.4rem;
        margin: 0 8px;
        color: #4e73df;
        transition: 0.3s;
      }
      .social-login a:hover {
        color: #1cc88a;
      }

        .input-group-text {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0.375rem 0.75rem; /* Ajusta si quieres más espacio */
            font-size: 1.1rem; /* Tamaño del icono */
            background-color: #f8f9fc;
            border-left: 0;
            height: 38px; /* Altura igual al input */
        }

        .input-group-text i {
        line-height: 1;
        }

  body
    .login-box
      .card.login-card(id=error ? 'shake-card' : '')
        .card-body.login-card-body
          h3.text-center.mb-4 Bienvenido a:

          .login-logo.mb-4
            img(src="/images/line_white_services.png", alt="Line White Services")

          if error
            .alert.alert-danger.text-center #{error}

          form(action="/login" method="post")
            .input-group.mb-3
              input.form-control(type="text", placeholder="Usuario", name="usuario", id="usuario", required)
              .input-group-append
                .input-group-text
                  i.fas.fa-user.fa-lg
            .input-group.mb-3
              input.form-control(type="password", placeholder="Contraseña", name="contrasena", id="contrasena", required)
              .input-group-append
                .input-group-text
                  i.fas.fa-lock.fa-lg
            button.btn.btn-primary.btn-block.mb-3(type="submit") Iniciar sesión

          .text-center.login-footer.mb-3
            a(href="#") ¿Olvidaste tu contraseña?

          .text-center.social-login
            a(href="#") 
              i.fab.fa-facebook-f
            a(href="#") 
              i.fab.fa-twitter
            a(href="#") 
              i.fab.fa-google