doctype html
html(lang="es")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title Login | Line White Services
    link(rel="stylesheet", href="/adminlte/css/adminlte.min.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")
    link(rel="stylesheet", href="/stylesheets/style.css")
      

  body
    .login-box
      .card.login-card(id=error ? 'shake-card' : '')
        .card-body.login-card-body
          h3.text-center.mb-4 Bienvenido a:

          .login-logo.mb-4
            img(src="/images/line_white_services.png", alt="Line White Services")

          if error
            .alert.alert-danger.text-center #{error}

          form
            label.sr-only(for="usuario") Usuario
            .input-group.mb-3
              input.form-control(type="text", placeholder="Usuario", name="usuario", id="usuario", required)
              .input-group-append
                .input-group-text
                  i.fas.fa-user.fa-lg
            label.sr-only(for="contrasena") Contraseña
            .input-group.mb-3
              input.form-control(type="password", placeholder="Contraseña", name="contrasena", id="contrasena", required)
              .input-group-append
                .input-group-text
                  i.fas.fa-lock.fa-lg
            button.btn.btn-primary.btn-block.mb-3(type="button", id="btn_login", name="btn_login") Iniciar sesión

          .text-center.login-footer.mb-3
            a(href="/recuperar_contraseña") ¿Olvidaste tu contraseña?

          .text-center.social-login
            a(href="https://www.facebook.com/?locale=es_LA", aria-label="Facebook") 
              i.fab.fa-facebook-f
            a(href="https://x.com/?lang=es", aria-label="Twitter" )
              i.fab.fa-twitter
            a(href="https://www.google.com/?hl=es", aria-label="Google") 
              i.fab.fa-google
    script.
      console.log('Iniciar login');

    script(src='/javascripts/login.js')