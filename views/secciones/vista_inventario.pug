extends ../compartidos/app-main

block content_secciones
    div(class="container-fluid")
        // begin::Row
        div(class="row m-1")
            // begin::Col
            div(class="col-lg-12 col-12")
                div(class="card")
                    div(class="card-header")
                        div(class="container-fluid")
                            div(class="row justify-content-end")
                                div(class="col-10")
                                    h3(class="card-title")
                                        strong Productos en inventario
                                div(class="col-2 text-end")
                                    div(class="d-grid gap-2")
                                        button(type="button", class="btn btn-primary", data-bs-toggle="modal", data-bs-target="#exampleModal") 
                                            i(class="bi bi-clipboard-plus-fill")
                                            |  Añadir
                                //- div(class="col-2 ")
                                //-     button(type="button", class="btn btn-primary") Añadir
                    div(class="card-body")
                        div(class="alert alert-success", role="alert") Se muestran todos los productos que se han registrado.
                        //- button(type="button", class="btn btn-primary mb-2") Añadir
                        input#search(class="form-control mb-3", type="text", placeholder="Buscar productos...")
                        #tabla-productos
            // end::Col

