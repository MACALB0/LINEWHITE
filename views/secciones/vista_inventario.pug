    script.
            console.log("#tabla-productos", Tabulator);
            const table = new Tabulator("#tabla-productos", {

            ajaxURL: "/api/users",

            layout: "fitColumns",

            responsiveLayout: "collapse",

            pagination: true,

            paginationSize: 10,

            placeholder: "No hay registros",

            columns: [
                {
                title: "ID Producto",
                field: "id",
                width: 80
                },
                {
                title: "Código",
                field: "name"
                },
                {
                title: "Marca",
                field: "name"
                },
                {
                title: "Modelo",
                field: "name"
                },
                {
                title: "Descripción",
                field: "name"
                },
                {
                title: "Sinonimos",
                field: "name"
                },
                {
                title: "Cantidad",
                field: "name"
                },
                {
                title: "Precio unitario",
                field: "name"
                },
                {
                title: "Orden de compra",
                field: "name"
                },
                {
                title: "Acciones",
                formatter: function() {
                    return `
                    <button class="btn btn-sm btn-primary">
                        Editar
                    </button>
                    `;
                },
                hozAlign: "center",
                width: 120
                }
            ]
            });

            document
            .getElementById("search")
            .addEventListener("keyup", function () {

                table.setFilter([
                [
                    { field: "name", type: "like", value: this.value },
                    { field: "email", type: "like", value: this.value }
                ]
                ]);

            });