extends ../compartidos/app-main

block content_secciones
    .card
        .card-header
            h3.card-title Órdenes técnicas

        .card-body
            .alert.alert-success(
                role="alert"
            ) Se muestran las órdenes técnicas registradas.

            input#search-ordenes.form-control.mb-3(
                type="text"
                placeholder="Buscar orden técnica..."
            )

            #tabla-ordenes

append scripts
    script(
        type="text/javascript"
        src="/tabulator/js/tabulator.min.js"
    )

    script.
        const table = new Tabulator("#tabla-ordenes", {
            ajaxURL: "/api/users",
            layout: "fitColumns",
            responsiveLayout: "collapse",
            pagination: true,
            paginationSize: 10,
            placeholder: "No hay registros",

            columns: [
                {
                    title: "ID Orden",
                    field: "id",
                    width: 100
                },
                {
                    title: "Cliente",
                    field: "name"
                },
                {
                    title: "Correo",
                    field: "email"
                },
                {
                    title: "Estado",
                    field: "role"
                },
                {
                    title: "Acciones",
                    formatter: function () {
                        return `
                            <button class="btn btn-sm btn-primary">
                                Ver detalle
                            </button>
                        `;
                    },
                    hozAlign: "center",
                    width: 130
                }
            ]
        });

        document
            .getElementById("search-ordenes")
            .addEventListener("keyup", function () {
                table.setFilter([
                    [
                        {
                            field: "name",
                            type: "like",
                            value: this.value
                        },
                        {
                            field: "email",
                            type: "like",
                            value: this.value
                        }
                    ]
                ]);
            });